-- Drum & bass from scratch
-- Hecho con Tidal Studio · 174 BPM

setcps (174/60/4)

-- Kick (percusion)
d1 $ mask "<f!4 t!12>" $ s "bd ~ ~ ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~" # gain 1

-- Snare (percusion)
d2 $ mask "<f!4 t!12>" $ s "~ sn ~ sn" # gain 1 # shape 0.2

-- Hi-hats (percusion)
d3 $ mask "<f!2 t!14>" $ s "hh*8" # gain "[0.7 0.5]*4"

-- Chopped break (percusion)
d4 $ mask "<f!8 t!8>" $ s "amencutup*16" # n (irand 32) # gain 0.6 # hpf 1500

-- Bass (bajo)
d5 $ mask "<f!4 t!12>" $ n "<[d3@6 f3@2] [bf2@6 a2@2] [f2@8] [c3@6 e3@2]>" # s "supersaw" # lpf 500 # legato 1 # gain 0.8

-- Pad (armonia)
d6 $ n "<d'min bf4'maj f4'maj c'maj>" # s "supersaw" # lpf 1800 # legato 1 # gain 0.4 # room 0.6 # size 0.9

-- Piano (melodia)
d7 $ mask "<t!4 f!4 t!8>" $ n "<[a6 ~ ~ f6 ~ ~ d6 ~] [~ ~ ~ ~ f6 ~ e6 d6] [c6 ~ ~ a5 ~ ~ c6 ~] [e6 ~ ~ ~ g6 ~ e6 ~]>" # s "superpiano" # gain 0.6 # room 0.4 # delay 0.35 # delaytime (60/174*0.75) # delayfeedback 0.4
